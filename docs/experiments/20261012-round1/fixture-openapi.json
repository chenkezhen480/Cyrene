          "customerId" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string",
            "minLength" : 1,
            "maxLength" : 200
          },
          "dueDate" : {
            "type" : "string",
            "format" : "date"
          },
          "idempotencyKey" : {
            "type" : "string",
            "minLength" : 1,
            "maxLength" : 100
          }
        },
        "required" : [ "customerId", "title", "dueDate", "idempotencyKey" ],
        "additionalProperties" : false
      },
      "UpdateTask" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "open", "inProgress", "done", "cancelled" ]
          },
          "expectedVersion" : {
            "type" : "integer",
            "minimum" : 1
