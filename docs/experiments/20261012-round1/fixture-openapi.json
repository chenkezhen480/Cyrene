      "get" : {
        "operationId" : "listCustomers",
        "description" : "List current user's customers ordered by id, with stable cursor pagination; expiresBefore compares renewalDate and inactiveBefore compares lastContactDate strictly before a fixed date",
        "responses" : {
          "200" : {
            "description" : "Successful result",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CustomerPage"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid request",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid credential",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403" : {
            "description" : "Token not authorized",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404" : {
            "description" : "Resource absent from current-user scope",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409" : {
            "description" : "Idempotency or version conflict",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503" : {
            "description" : "Fixture storage unavailable",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters" : [ {
          "name" : "limit",
          "in" : "query",
          "schema" : {
            "type" : "integer",
            "minimum" : 1,
            "maximum" : 100,
            "default" : 50
          }
        }, {
          "name" : "cursor",
          "in" : "query",
          "description" : "Opaque cursor from pageInfo.nextCursor; preserve the same filters and user credential",
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "expiresBefore",
          "in" : "query",
          "description" : "Strictly before this YYYY-MM-DD date",
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        }, {
          "name" : "inactiveBefore",
          "in" : "query",
          "description" : "Strictly before this YYYY-MM-DD date",
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        } ]
      }
    },
