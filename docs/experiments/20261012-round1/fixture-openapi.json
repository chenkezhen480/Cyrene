{
  "openapi" : "3.0.3",
  "info" : {
    "title" : "Synthetic Cyrene CRM fixture",
    "version" : "1",
    "description" : "Isolated fictional business fixture. Dates are fixed to benchmark date 2026-10-12. Authentication fixes tenant and owner; no owner or tenant override is accepted. Error NOT_FOUND does not reveal whether another owner has the record."
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
