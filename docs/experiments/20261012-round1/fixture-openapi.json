        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "tenantId" : {
            "type" : "string"
          },
          "ownerId" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "tier" : {
            "type" : "string"
          },
          "region" : {
            "type" : "string"
          },
          "renewalDate" : {
            "type" : "string",
            "format" : "date"
          },
          "lastContactDate" : {
            "type" : "string",
            "format" : "date"
          },
          "billingHold" : {
            "type" : "boolean"
          }
        },
        "required" : [ "id", "tenantId", "ownerId", "name", "tier", "region", "renewalDate", "lastContactDate", "billingHold" ],
        "additionalProperties" : false
      },
      "Task" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "tenantId" : {
            "type" : "string"
          },
          "ownerId" : {
            "type" : "string"
          },
          "customerId" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "idempotencyKey" : {
            "type" : "string"
          },
          "dueDate" : {
            "type" : "string",
