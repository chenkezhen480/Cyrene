# ============================================================
# Cyrene Agent - Environment Configuration
# Cyrene Agent - 环境变量配置
# Copy this file to .env and fill in your values
# 复制此文件为 .env 并填入你的配置
#
# This file is auto-loaded by EnvConfig if present in the working directory.
# System environment variables take precedence over values in this file.
# ============================================================


# ============================================================
# 1. Gap Analysis / 动态路由 (查询特征分析 → 动态决定处理策略)
# ============================================================
#
# 三级判定漏斗（每级只填充上一级为 null 的字段）：
#   Tier 0: 客户端显式覆盖（AgentContext，最高优先级）
#   Tier 1: 规则引擎（硬编码正则/关键词匹配，<1ms）
#   Tier 2: LLM 分类（调用子 Agent 小任务模型，三维度分析）
#
# 四个独立字段（不互斥，可同时为 true）：
#   needsThinking      → 是否启用深度思考（ReActEngine）
#   needsKnowledgeBase  → 是否检索内部知识库（ContextBuilder）
#   needsWebSearch      → 是否联网搜索（WebSearchTool）
#
# 判定结果写入 trace metadata（gap_source = explicit/rule/llm/default）
# Tier 2 失败时自动降级到环境变量默认值，不阻塞主流程

# 功能总开关（false 时所有字段回退全局静态配置，行为与未集成 GapAnalyzer 时一致）
HARNESS_GAP_ANALYSIS_ENABLED=false


# ============================================================
# 2. Model Configuration / 模型配置 (7 种模型类型；子 Agent 模型用于 GapAnalyzer 等轻量小任务)
# ============================================================

# --- Chat Model (对话 + 工具调用 / Chat + Tool Calling) ---
# Provider: openai | anthropic | ollama
HARNESS_MODEL_CHAT_PROVIDER=openai
HARNESS_MODEL_CHAT_API_KEY=sk-your-api-key
HARNESS_MODEL_CHAT_BASE_URL=https://api.openai.com/v1
HARNESS_MODEL_CHAT_MODEL=gpt-4o
# OpenAI-compatible 上游协议：chat_completions | responses
# responses 仍发送 Cyrene 本地完整会话，不使用 previousResponseId 或 Provider 托管状态
HARNESS_MODEL_CHAT_API_FORMAT=chat_completions
HARNESS_MODEL_CHAT_MAX_TOKENS=16384
HARNESS_MODEL_CHAT_TEMPERATURE=0.7
# 是否开启思考模式（影响 DashScope 等支持思考模式的 API）
HARNESS_MODEL_CHAT_THINKING=true
# LLM API 超时时间（秒），默认 300（5分钟）
HARNESS_MODEL_CHAT_TIMEOUT_SECONDS=300
# 手动声明模型多模态能力（覆盖自动检测），逗号分隔: text, image_input, audio_input, pdf_input
HARNESS_MODEL_CHAT_CAPABILITIES=

# --- Vision Model (图片识别 / 视频分析) ---
# Provider: openai | anthropic | (留空则回退到 chat model)
HARNESS_MODEL_VISION_PROVIDER=
HARNESS_MODEL_VISION_API_KEY=
HARNESS_MODEL_VISION_BASE_URL=
HARNESS_MODEL_VISION_MODEL=

# --- Voice Model (ASR 语音识别 + TTS 语音合成) ---
# Provider: openai | (留空则禁用)
HARNESS_MODEL_VOICE_PROVIDER=
HARNESS_MODEL_VOICE_API_KEY=
HARNESS_MODEL_VOICE_BASE_URL=
HARNESS_MODEL_VOICE_ASR_MODEL=whisper-1
HARNESS_MODEL_VOICE_TTS_MODEL=tts-1
HARNESS_MODEL_VOICE_TIMEOUT_SECONDS=120
HARNESS_MODEL_VOICE_ASR_MAX_SIZE_MB=20
# 可选默认音色；流式、编码、切句和队列参数使用内部统一默认值
HARNESS_MODEL_VOICE_TTS_DEFAULT_VOICE=alloy

# --- Embedding Model (多模态向量化) ---
# Provider: openai | ollama | (留空则禁用)
HARNESS_MODEL_EMBEDDING_PROVIDER=
HARNESS_MODEL_EMBEDDING_API_KEY=
HARNESS_MODEL_EMBEDDING_BASE_URL=
HARNESS_MODEL_EMBEDDING_MODEL=text-embedding-3-small
HARNESS_MODEL_EMBEDDING_DIM=1536

# --- Rerank Model (向量检索结果重排序) ---
# Provider: (留空则使用分数排序)
HARNESS_MODEL_RERANK_PROVIDER=
HARNESS_MODEL_RERANK_API_KEY=
HARNESS_MODEL_RERANK_BASE_URL=
HARNESS_MODEL_RERANK_MODEL=
HARNESS_RERANK_ENABLED=false
HARNESS_RERANK_TOP_N=3

# --- Realtime Model (实时多模态 - 预留) ---
HARNESS_MODEL_REALTIME_PROVIDER=
HARNESS_MODEL_REALTIME_API_KEY=
HARNESS_MODEL_REALTIME_BASE_URL=

# --- Sub-Agent Small-Task Model (子 Agent 小任务模型 / GapAnalyzer Tier 2) ---
# 用于 GapAnalyzer 等内部轻量小任务；不是主 Agent 通过 spawn_subagent 分发的异步子 Agent 执行模型
# 当前实现执行 Tier 2 LLM 分类，分析查询特征决定三个路由字段
# Provider: openai (OpenAI 兼容 API，包括 GLM-4.7-flash 等) | (留空则禁用 Tier 2，仅 Tier 0+1 生效)
# thinking 固定关闭（构建时通过 customParameters 设置），max_tokens 锁定 50，非流式
HARNESS_MODEL_CLASSIFIER_PROVIDER=
HARNESS_MODEL_CLASSIFIER_API_KEY=
HARNESS_MODEL_CLASSIFIER_BASE_URL=
HARNESS_MODEL_CLASSIFIER_MODEL=
# 小任务模型最大输出 token（当前只需输出压缩 JSON，如 {"t":true,"k":false,"s":false}）
HARNESS_MODEL_CLASSIFIER_MAX_TOKENS=50

# --- Image Generation / 图片生成 ---
HARNESS_TOOL_IMAGE_GEN_PROVIDER=openai
HARNESS_TOOL_IMAGE_GEN_API_KEY=
HARNESS_TOOL_IMAGE_GEN_BASE_URL=https://api.openai.com/v1
HARNESS_TOOL_IMAGE_GEN_MODEL=dall-e-3

# --- Video Generation / 视频生成（异步回调，暂未完善）---
# BASE_URL 需包含版本路径（如 https://api.kling.ai/v1）
# SUBMIT_PATH / STATUS_PATH 拼接在 BASE_URL 后，不同 API 路径不同：
#   Kling:  /videos/generations  /videos/generations
#   Runway: /tasks               /tasks
HARNESS_TOOL_VIDEO_GEN_PROVIDER=
HARNESS_TOOL_VIDEO_GEN_API_KEY=
HARNESS_TOOL_VIDEO_GEN_BASE_URL=
HARNESS_TOOL_VIDEO_GEN_MODEL=
HARNESS_TOOL_VIDEO_GEN_SUBMIT_PATH=/submit
HARNESS_TOOL_VIDEO_GEN_STATUS_PATH=/status


# ============================================================
# 3. Server & Authentication / 服务与认证
# ============================================================

# --- HTTP Server / HTTP 服务 ---
HARNESS_SERVER_ENABLED=true
HARNESS_SERVER_HOST=0.0.0.0
HARNESS_SERVER_PORT=8080
HARNESS_SERVER_WORKERS=4
HARNESS_SERVER_IDLE_TIMEOUT=300000  # HTTP connection idle timeout in ms (default 300000 = 5 min)
HARNESS_SERVER_MAX_REQUEST_SIZE_MB=20  # Max HTTP request body size in MB (default 20, needed for file uploads)

# --- Authentication / 认证模式 ---
# mode: none (无认证，所有请求匿名)
#       jwt  (需要 Bearer token 校验，通过 POST /api/auth/token 获取)
HARNESS_AUTH_MODE=none
HARNESS_AUTH_TOKEN=your-auth-token
HARNESS_AUTH_JWT_SECRET=your-jwt-secret
HARNESS_AUTH_JWT_ISSUER=harness-agent
# JWT 滑动窗口刷新：剩余有效期小于此阈值时刷新 token（分钟）
HARNESS_AUTH_JWT_REFRESH_THRESHOLD_MINUTES=60


# ============================================================
# 4. RAG Vector Store / RAG 向量存储
# ============================================================
# Provider: pgvector | milvus | none
# PG 和 Milvus 共存，通过 HARNESS_RAG_PROVIDER 选择使用哪个

# Provider: milvus | pgvector | none
# Docker Compose 部署默认使用 Milvus（已内置在 docker-compose.yml 中）
HARNESS_RAG_PROVIDER=milvus

# 通用配置
HARNESS_RAG_COLLECTION=default
HARNESS_RAG_DATABASE=default
HARNESS_RAG_TOP_K=5
HARNESS_RAG_SCORE_THRESHOLD=0.7
# 仅当过滤前最高候选分达到该值但仍低于 SCORE_THRESHOLD 时，允许隐式查询改写一次
HARNESS_RAG_REWRITE_MIN_SCORE=0.3
HARNESS_RAG_EMBED_DIM=1536

# Provider 专用配置（根据 RAG_PROVIDER 选填）
# Milvus: RAG_URL=http://host:19530  RAG_API_KEY  RAG_MILVUS_METRIC_TYPE  RAG_BM25_WEIGHT
# PG:     RAG_URL=jdbc:postgresql://host:5432/agent  RAG_USER  RAG_PASS
HARNESS_RAG_URL=http://localhost:19530
HARNESS_RAG_MILVUS_METRIC_TYPE=COSINE
HARNESS_RAG_BM25_WEIGHT=0.3
# HARNESS_RAG_API_KEY=

# PG 专用（仅 HARNESS_RAG_PROVIDER=pgvector 时生效）
# HARNESS_RAG_URL=jdbc:postgresql://localhost:5432/agent
# HARNESS_RAG_USER=postgres
# HARNESS_RAG_PASS=your-pg-password

# --- 显式知识上下文窗口 ---
# readContext 的 before/after 单侧最大 Chunk 数
HARNESS_RAG_CONTEXT_WINDOW_MAX=2

# --- 知识图谱（只需配置开关和密码，其余参数均有默认值）---
# 启用后启动 Neo4j：
# docker compose --env-file .env -f docker/docker-compose.yml --profile graph up -d neo4j
HARNESS_GRAPH_PROVIDER=none
HARNESS_GRAPH_NEO4J_PASSWORD=change-this-graph-password
#-------------非必填-----------------
HARNESS_GRAPH_NEO4J_DATABASE=neo4j
HARNESS_GRAPH_CONNECT_TIMEOUT_SECONDS=10
HARNESS_GRAPH_QUERY_TIMEOUT_SECONDS=15
HARNESS_GRAPH_MAX_CONNECTION_POOL_SIZE=20
HARNESS_GRAPH_QUERY_DEFAULT_LIMIT=50
HARNESS_GRAPH_QUERY_MAX_LIMIT=200
HARNESS_GRAPH_QUERY_DEFAULT_MAX_DEPTH=1
HARNESS_GRAPH_QUERY_MAX_DEPTH=2
HARNESS_GRAPH_CONTEXT_MAX_ITEMS=50
HARNESS_GRAPH_CONTEXT_MAX_CHARS=12000

# --- Knowledge Base / 知识库（文档写入 RAG） ---
HARNESS_KNOWLEDGE_UPLOAD_DIR=./knowledge-uploads
HARNESS_KNOWLEDGE_MAX_FILE_SIZE_MB=50
HARNESS_KNOWLEDGE_CHUNK_SIZE=1000
HARNESS_KNOWLEDGE_PDF_ENABLED=true
HARNESS_KNOWLEDGE_DOCX_ENABLED=true
HARNESS_KNOWLEDGE_XLSX_ENABLED=true
HARNESS_KNOWLEDGE_PPTX_ENABLED=true


# ============================================================
# 5. Database / 其他数据库配置
# ============================================================

# --- Storage（统一存储，记忆 + Trace 共享） ---
# Store type: mysql | sqlite | none
# mysql: 记忆（session/message/preference）+ Trace 都走 MySQL
# sqlite: 仅 Trace 走 SQLite，记忆为 NoOp
# none: 都不启用
# Docker Compose 部署时自动使用容器内的 MySQL，无需手动配置连接地址
HARNESS_AUDIT_STORE=mysql
HARNESS_AUDIT_DB_URL=jdbc:mysql://localhost:3306/agent?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
HARNESS_AUDIT_DB_USER=root
HARNESS_AUDIT_DB_PASS=cyrene123
# 审计 trace 保留天数，超期自动清理，设为 0 禁用
HARNESS_AUDIT_RETENTION_DAYS=30

# --- Redis (Session Cache / 会话缓存) ---
# Docker Compose 部署时自动使用容器内的 Redis，无需手动配置
# 持久层不变；Redis 仅替换内存缓存
HARNESS_MEMORY_REDIS_URL=redis://localhost:6379
HARNESS_MEMORY_REDIS_PASSWORD=
HARNESS_MEMORY_REDIS_DB=0
HARNESS_MEMORY_REDIS_KEY_PREFIX=harness
HARNESS_MEMORY_REDIS_TTL_MINUTES=720


# ============================================================
# 6. Memory Management & Context Budget / 内存管理与上下文预算
# ============================================================

# --- Session Lifecycle / 会话生命周期 ---
HARNESS_SESSION_TIMEOUT_MINUTES=30
HARNESS_MEMORY_CLEANUP_INTERVAL_MINUTES=60

# --- Long-term Memory Refinement / 长期记忆提炼 ---
HARNESS_MEMORY_MIN_MESSAGES=5
HARNESS_MEMORY_MIN_USER_CHARS=100
HARNESS_MEMORY_LONGTERM_MAX_TOKENS=800
HARNESS_MEMORY_REFINEMENT_MIN_SCORE=30

# --- Compression Strategy / 压缩策略 ---
# 小压缩：预处理层自动清除缓存中的工具消息（零 LLM 成本），大压缩前自动触发
# 大压缩：AI 智能提炼旧消息
HARNESS_CTX_COMPRESS_MAJOR=85
HARNESS_CTX_COMPRESS_MAJOR_TARGET=30

# --- Session Cache / 会话缓存 ---
HARNESS_CACHE_MAX_SESSIONS_PER_USER=10
HARNESS_CACHE_MAX_MB_PER_USER=2
HARNESS_CACHE_MAX_MB_GLOBAL=4096
HARNESS_CACHE_EVICTION_TARGET_RATIO=50
HARNESS_CACHE_SESSION_TTL_HOURS=12

# --- System Prompt / 系统提示词 ---
# HARNESS_SYSTEM_PROMPT=You are Cyrene, a helpful AI assistant with access to tools. Use tools when needed to answer questions. Think step by step. If a tool fails, try an alternative approach.


# ============================================================
# 7. Tool Configuration & Feature Toggles / 工具配置与功能开关
# ============================================================

# --- Web Search / 联网搜索 ---
# 联网搜索（基于自托管 SearXNG，聚合 70+ 搜索引擎，无需 API Key）
HARNESS_TOOL_WEB_SEARCH_ENABLED=true
# Docker Compose 部署时使用容器内部地址 http://searxng:8888
HARNESS_TOOL_WEB_SEARCH_SEARXNG_URL=http://localhost:8888
# 此清单是唯一的引擎选择来源，web_search 会随每次请求传给 SearXNG
HARNESS_TOOL_WEB_SEARCH_ENGINES=bing,duckduckgo,brave,google,wikipedia
HARNESS_TOOL_WEB_SEARCH_RESULT_LIMIT=8
# 可选：不设置时 Compose 会在每次创建 SearXNG 容器时生成随机值；生产环境建议固定
SEARXNG_SECRET=

# --- Single URL content reader / 单网址内容读取 ---
# 单网址正文读取工具默认启用；无需配置分页、大小和超时参数。
HARNESS_TOOL_URL_READER_ENABLED=true

# --- Browser control worker / 网页界面控制容器（暂未完善） ---
# 是否注册网页控制工具；启用前必须配置并启动 browser-worker。
HARNESS_TOOL_BROWSER_ENABLED=false
# Java Agent 与 browser-worker 之间的共享访问密钥；必须使用独立的随机值，不要提交真实值。
# Windows PowerShell 5.1+ 随机 Token 生成命令：
# $tokenBytes = New-Object byte[] 32
# $tokenRng = [Security.Cryptography.RandomNumberGenerator]::Create()
# $tokenRng.GetBytes($tokenBytes)
# $tokenRng.Dispose()
# [BitConverter]::ToString($tokenBytes).Replace("-", "")
HARNESS_TOOL_BROWSER_WORKER_TOKEN=

# --- FFmpeg Tool / 音视频处理工具（暂未完善） ---
HARNESS_TOOL_FFMPEG_ENABLED=false
HARNESS_TOOL_FFMPEG_PATH=ffmpeg

# --- Python Sandbox / Python 沙盒（Code Interpreter）---
# 需要预构建 Docker 镜像：docker build -t cyrene-sandbox:latest docker/sandbox/
HARNESS_SANDBOX_DOCKER_IMAGE=cyrene-sandbox:latest
HARNESS_SANDBOX_TIMEOUT_SECONDS=120
HARNESS_SANDBOX_MEMORY_MB=512
HARNESS_SANDBOX_MAX_CONCURRENT=3

# --- Artifact Storage / 产物存储 ---
HARNESS_ARTIFACT_DIR=./artifacts
HARNESS_ARTIFACT_MAX_SIZE_MB=50

# --- MCP Remote Tools / MCP 远程工具 ---
# JSON 配置文件，每个服务器可独立设置超时
# HARNESS_MCP_CONFIG_FILE=mcp-servers.json
HARNESS_MCP_CONNECT_TIMEOUT_MS=5000
HARNESS_MCP_CALL_TIMEOUT_MS=30000

# --- ReAct Loop / ReAct 循环 ---
HARNESS_REACT_MAX_ITERATIONS=99
HARNESS_REACT_STRATEGY=react
# 自适应反思触发阈值（连续 N 次非 PASS 结果触发反思提示），默认 3
HARNESS_REACT_REFLECTION_THRESHOLD=3

# --- Structured Output / 结构化输出 Schema 安全限制 ---
HARNESS_STRUCTURED_SCHEMA_MAX_BYTES=65536
HARNESS_STRUCTURED_SCHEMA_MAX_DEPTH=12
HARNESS_STRUCTURED_SCHEMA_MAX_PROPERTIES=200
HARNESS_STRUCTURED_SCHEMA_MAX_ENUM_VALUES=500

# --- LLM API 并发保护 ---
HARNESS_MODEL_API_MAX_CONCURRENT=100

# --- Sub-Agent / 子代理 ---
HARNESS_AGENT_MAX_SUBAGENTS=5

# --- Multimodal Input / 多模态输入 ---
HARNESS_MULTIMODAL_IMAGE_ENABLED=true
HARNESS_MULTIMODAL_VIDEO_ENABLED=false
HARNESS_MULTIMODAL_FILE_MAX_SIZE_MB=50
HARNESS_MULTIMODAL_URL_BLOCK_PRIVATE_IPS=true

# --- Risk Control / 风控 ---
# 额外强制用户确认的已有工具名称，多个名称使用英文逗号分隔。
HARNESS_RISK_CONFIRM_TOOLS=update_project_api
# 工具可处理的最大文件大小，单位为 MiB。
HARNESS_RISK_MAX_FILE_SIZE_MB=100
# 禁止工具访问的域名，多个域名使用英文逗号分隔，并同时匹配其子域名。
HARNESS_RISK_BLOCKED_DOMAINS=


# ============================================================
# 8. Input Processing / 输入处理 (大文件解析)
# ============================================================

HARNESS_INPUT_FILE_SIZE_THRESHOLD_KB=1024
HARNESS_INPUT_CHUNK_TOKEN_SIZE=1024
# MarkItDown document parser. In Docker Compose use the service name below;
# local Java development can override it with http://127.0.0.1:8082.
# Image OCR uses HARNESS_MODEL_VISION_* when configured; otherwise it reuses
# the complete HARNESS_MODEL_CHAT_* group, whose model must support image input.
# Set HARNESS_MODEL_VISION_PROVIDER=none to disable document vision explicitly.
HARNESS_DOCUMENT_PARSER_URL=http://document-parser:8082
HARNESS_DOCUMENT_PARSER_TOKEN=
HARNESS_DOCUMENT_PARSER_TIMEOUT_SECONDS=300
HARNESS_DOCUMENT_PARSER_REQUEST_TIMEOUT_SECONDS=315
HARNESS_DOCUMENT_PARSER_VISION_TIMEOUT_SECONDS=60
HARNESS_DOCUMENT_PARSER_MAX_FILE_SIZE_MB=50
HARNESS_DOCUMENT_PARSER_MAX_CONCURRENT=4
HARNESS_DOCUMENT_PARSER_HOST=0.0.0.0
HARNESS_DOCUMENT_PARSER_PORT=8082
# 模型上下文窗口大小 (token)，根据模型名称自动检测，仅在需要覆盖时设置
#HARNESS_MODEL_CHAT_CONTEXT_WINDOW=128000
HARNESS_LARGE_FILE_CONTEXT_RATIO=0.4
HARNESS_LARGE_FILE_SUMMARY_CONCURRENCY=3


# ============================================================
# 10. Project API Discovery / 项目接口发现（生产环境建议关闭）
# ============================================================

# 功能总开关（true 时 code_glob/code_grep/read_class_hierarchy 工具对正常会话可用）
HARNESS_PROJECT_DISCOVERY_ENABLED=true
# 声明式配置文件路径
HARNESS_PROJECT_APIS_CONFIG_FILE=./project-apis.json
