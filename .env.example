# ============================================================
# Cyrene Agent - Environment Configuration
# Cyrene Agent - 环境变量配置
# Copy this file to .env and fill in your values
# 复制此文件为 .env 并填入你的配置
#
# This file is auto-loaded by EnvConfig if present in the working directory.
# System environment variables take precedence over values in this file.
# ============================================================


# ============================================================
# 1. Model Configuration / 模型配置 (6 种模型类型，各自独立配置)
# ============================================================

# --- Chat Model (对话 + 工具调用 / Chat + Tool Calling) ---
# Provider: openai | anthropic | ollama
HARNESS_MODEL_CHAT_PROVIDER=openai
HARNESS_MODEL_CHAT_API_KEY=sk-your-api-key
HARNESS_MODEL_CHAT_BASE_URL=https://api.openai.com/v1
HARNESS_MODEL_CHAT_MODEL=gpt-4o
HARNESS_MODEL_CHAT_MAX_TOKENS=4096
HARNESS_MODEL_CHAT_TEMPERATURE=0.7
# Enable thinking/reasoning mode (DashScope enable_thinking, etc.)
# 是否开启思考模式（影响 DashScope 等支持思考模式的 API）
HARNESS_MODEL_CHAT_THINKING=true
# Manually declare model modal capabilities (overrides auto-detection)
# 手动声明模型多模态能力（覆盖自动检测），逗号分隔: text, image_input, audio_input, pdf_input
HARNESS_MODEL_CHAT_CAPABILITIES=

# --- Vision Model (图片识别 / 视频分析 / Image & Video Analysis) ---
# Provider: openai | anthropic | (leave empty to fall back to chat model / 留空则回退到 chat model)
HARNESS_MODEL_VISION_PROVIDER=
HARNESS_MODEL_VISION_API_KEY=
HARNESS_MODEL_VISION_BASE_URL=
HARNESS_MODEL_VISION_MODEL=

# --- Voice Model (ASR 语音识别 + TTS 语音合成 / Speech Recognition & Synthesis) ---
# Provider: openai | (leave empty to disable / 留空则禁用)
HARNESS_MODEL_VOICE_PROVIDER=
HARNESS_MODEL_VOICE_API_KEY=
HARNESS_MODEL_VOICE_BASE_URL=
HARNESS_MODEL_VOICE_ASR_MODEL=whisper-1
HARNESS_MODEL_VOICE_TTS_MODEL=tts-1

# --- Embedding Model (多模态向量化 / Multimodal Embedding) ---
# Provider: openai | ollama | (leave empty to disable / 留空则禁用)
HARNESS_MODEL_EMBEDDING_PROVIDER=
HARNESS_MODEL_EMBEDDING_API_KEY=
HARNESS_MODEL_EMBEDDING_BASE_URL=
HARNESS_MODEL_EMBEDDING_MODEL=text-embedding-3-small
HARNESS_MODEL_EMBEDDING_DIM=1536

# --- Rerank Model (向量检索结果重排序 / Retrieval Result Reranking) ---
# Provider: (leave empty to use score-based sorting / 留空则使用分数排序)
HARNESS_MODEL_RERANK_PROVIDER=
HARNESS_MODEL_RERANK_API_KEY=
HARNESS_MODEL_RERANK_BASE_URL=
HARNESS_MODEL_RERANK_MODEL=

# --- Realtime Model (实时多模态 - 预留 / Realtime Multimodal - Reserved) ---
HARNESS_MODEL_REALTIME_PROVIDER=
HARNESS_MODEL_REALTIME_API_KEY=
HARNESS_MODEL_REALTIME_BASE_URL=


# ============================================================
# 2. Server & Authentication / 服务与认证
# ============================================================

# --- HTTP Server / HTTP 服务 ---
HARNESS_SERVER_ENABLED=true
HARNESS_SERVER_HOST=0.0.0.0
HARNESS_SERVER_PORT=8080
HARNESS_SERVER_WORKERS=4

# --- CLI Mode / CLI 模式 ---
HARNESS_CLI_ENABLED=false

# --- Authentication / 认证模式 ---
# mode: none (no auth, all requests anonymous / 无认证，所有请求匿名)
#       jwt  (Bearer token required / 需要 Bearer token 校验)
# jwt mode requires server to be running; obtain token via POST /api/auth/token
# jwt 模式下必须启动 server，token 通过 POST /api/auth/token 获取
HARNESS_AUTH_MODE=none
HARNESS_AUTH_TOKEN=your-auth-token
HARNESS_AUTH_JWT_SECRET=your-jwt-secret
HARNESS_AUTH_JWT_ISSUER=harness-agent
# JWT sliding window refresh: refresh token if remaining lifetime < this threshold (minutes)
# JWT 滑动窗口刷新：剩余有效期小于此阈值时刷新 token（分钟）
HARNESS_AUTH_JWT_REFRESH_THRESHOLD_MINUTES=60


# ============================================================
# 3. Database / 数据库配置
# ============================================================

# --- PostgreSQL pgvector (RAG Knowledge Base Vector Store / RAG 知识库向量存储) ---
HARNESS_RAG_PROVIDER=pgvector
HARNESS_RAG_PG_URL=jdbc:postgresql://localhost:5432/agent
HARNESS_RAG_PG_USER=postgres
HARNESS_RAG_PG_PASS=your-pg-password
HARNESS_RAG_PG_TABLE=knowledge_documents
HARNESS_RAG_PG_EMBED_DIM=1536
# RAG retrieval parameters / RAG 检索参数
HARNESS_RAG_COLLECTION=default
HARNESS_RAG_TOP_K=5
HARNESS_RAG_SCORE_THRESHOLD=0.7
# Semantic context lookback: max previous chunks to fetch when a chunk is truncated
# 语义上下文回溯：截断 chunk 时最多向前查找的 chunk 数
HARNESS_RAG_CONTEXT_LOOKBACK_MAX=2
# Rerank toggle and top N / Rerank 开关与取 top N
HARNESS_RERANK_ENABLED=false
HARNESS_RERANK_TOP_N=3

# --- Query Rewriting / 查询改写 ---
# Rewrite user query before retrieval to improve recall / 检索前改写用户查询以提高召回率
# Strategy: none | hyde | multi-query | step-back
#   none        = 关闭，直接用原始查询检索
#   hyde        = 假设性文档嵌入：LLM 生成一段"假答案"，用假答案去向量检索（适合短查询）
#   multi-query = 多查询改写：LLM 生成多个不同措辞的查询，分别检索后合并（提高召回覆盖率）
#   step-back   = 抽象化改写：LLM 生成更通用的查询，先获取背景知识（适合过于具体的问题）
HARNESS_RAG_QUERY_REWRITE=none
# Number of alternative queries for multi-query strategy / multi-query 策略的备选查询数（不含原始查询）
HARNESS_RAG_QUERY_REWRITE_COUNT=3

# --- Multi-Route Retrieval / 多路召回 ---
# Enable parallel retrieval from multiple backends, merge results by document ID
# 启用多路并行召回，按文档 ID 去重合并结果
# false = 只用 HARNESS_RAG_PROVIDER 指定的单一路由（默认）
# true  = 启用多路并行，以下各路由可独立开关
HARNESS_RAG_MULTI_ROUTE=false
# Enable fulltext keyword retrieval route (runs in parallel with semantic vector retrieval)
# 启用全文关键词检索路线（与语义向量召回并行，互补）
# Requires: run the fulltext section in sql/schema-pgvector.sql first (adds content_tsv column + GIN index)
# 前置条件：需先执行 sql/schema-pgvector.sql 中的全文检索段（添加 content_tsv 列 + GIN 索引）
HARNESS_RAG_FULLTEXT_ENABLED=false
# PostgreSQL text search language config / PostgreSQL 全文检索分词语言配置
#   'english' = 英文模式，自动词干提取（running→run），适合英文文档
#   'simple'  = 简单模式，按空格/标点分词，不做词干提取，适合中文（但中文无空格分隔效果有限）
#   'jieba'   = 中文结巴分词（需额外安装 pg_jieba 扩展）
HARNESS_RAG_FULLTEXT_LANG=english
# Enable knowledge graph retrieval route (reserved, not yet implemented)
# 启用知识图谱召回路线（预留，暂未实现）
HARNESS_RAG_KNOWLEDGE_GRAPH_ENABLED=false

# --- MySQL (Audit Trace Store / 审计 trace 存储) ---
# Store type: sqlite | mysql | file | none
# 存储类型：sqlite | mysql | file | none
HARNESS_AUDIT_STORE=sqlite
HARNESS_AUDIT_DB_URL=jdbc:sqlite:harness_trace.db
HARNESS_AUDIT_DB_USER=
HARNESS_AUDIT_DB_PASS=

# Uncomment below to use MySQL for audit / 取消注释以使用 MySQL 存储审计数据
# HARNESS_AUDIT_STORE=mysql
# HARNESS_AUDIT_DB_URL=jdbc:mysql://localhost:3306/agent?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
# HARNESS_AUDIT_DB_USER=root
# HARNESS_AUDIT_DB_PASS=your-mysql-password

# --- MySQL (Session Memory Store / 会话记忆存储) ---
# Store type: mysql | sqlite | none (default)
# 存储类型：mysql | sqlite | none（默认）
HARNESS_MEMORY_STORE=none

# Uncomment below to use MySQL for memory / 取消注释以使用 MySQL 存储会话记忆
# HARNESS_MEMORY_STORE=mysql


# ============================================================
# 4. Memory Management & Context Budget / 内存管理与上下文预算
# ============================================================

# --- Session Lifecycle / 会话生命周期 ---
HARNESS_SESSION_TIMEOUT_MINUTES=30
HARNESS_MEMORY_CLEANUP_INTERVAL_MINUTES=60

# --- Long-term Memory Refinement Thresholds / 长期记忆提炼门槛 ---
# Session must meet these thresholds to trigger PreferenceRefinementWorker
# session 达到以下阈值才会触发长期记忆提炼
HARNESS_MEMORY_MIN_MESSAGES=5
HARNESS_MEMORY_MIN_USER_CHARS=100
# Max tokens for long-term memory (user preferences) injected into system prompt
# 长期记忆（用户偏好）注入 system prompt 的最大 token 数
HARNESS_MEMORY_LONGTERM_MAX_TOKENS=800
# Minimum session quality score to trigger refinement (0-100)
# 触发长期记忆提炼的最低 session 质量分数（0-100）
HARNESS_MEMORY_REFINEMENT_MIN_SCORE=30

# --- Compression Strategy / 压缩策略 ---
# Minor compression (ReAct layer, code-based): strip tool call/result messages during ReAct loop
# 小压缩 (ReAct 层，代码级): ReAct 循环中去除工具调用/结果消息，零 LLM 成本
# Iteration threshold: strip when current iteration > this value (e.g. 2 = start stripping from iteration 3)
# 迭代轮次阈值：当前迭代 > 此值时触发（例如 2 = 从第 3 轮开始去除）
HARNESS_CTX_COMPRESS_MINOR=2
# Enable/disable minor compression (true/false)
# 开关小压缩（true/false）
HARNESS_CTX_COMPRESS_MINOR_ENABLED=true
# Major compression (preprocess layer, AI-based): intelligent message extraction
# 大压缩 (预处理层，AI 级): 智能提炼旧消息
HARNESS_CTX_COMPRESS_MAJOR=85
HARNESS_CTX_COMPRESS_MAJOR_TARGET=30

# --- Session Cache / 会话缓存 ---
# Max sessions per user; evict user's oldest session when exceeded
# 单用户最大会话数，超出时淘汰该用户最旧的会话
HARNESS_CACHE_MAX_SESSIONS_PER_USER=10
# Max cache memory per user in MB; evict user's oldest session when exceeded
# 单用户缓存内存上限 (MB)，超出时淘汰该用户最旧的会话
HARNESS_CACHE_MAX_MB_PER_USER=2
# Global cache memory cap in MB
# 全局缓存内存上限 (MB)
HARNESS_CACHE_MAX_MB_GLOBAL=4096
# Eviction target ratio (1-100); global eviction stops when memory drops below this % of global cap
# 全局淘汰目标比例 (1-100)，内存降到此百分比以下停止淘汰
HARNESS_CACHE_EVICTION_TARGET_RATIO=50
# Cache session TTL in hours; idle sessions expired by background cleanup
# 缓存 session 过期时间 (小时)，空闲超时自动淘汰
HARNESS_CACHE_SESSION_TTL_HOURS=12

# --- System Prompt / 系统提示词 ---
# Base system prompt injected into every conversation. Leave empty to use default.
# 基础系统提示词，注入每次对话。留空则使用默认值。
# HARNESS_SYSTEM_PROMPT=You are a helpful AI assistant with access to tools. Use tools when needed to answer questions. Think step by step. If a tool fails, try an alternative approach.


# ============================================================
# 5. Feature Toggles / 功能开关
# ============================================================

# --- Built-in Tools / 内置工具 ---
HARNESS_TOOL_WEB_SEARCH_ENABLED=true
# Fallback chain: engines tried in priority order, skip those without API keys
# 回退链：按优先级尝试各引擎，无 API key 的引擎自动跳过
# Priority: comma-separated engine names, default "tavily,serpapi,duckduckgo"
HARNESS_TOOL_WEB_SEARCH_PRIORITY=tavily,serpapi,duckduckgo
# Per-engine API keys (TOOL_WEB_SEARCH_API_KEY used as fallback for Tavily)
HARNESS_TOOL_WEB_SEARCH_TAVILY_API_KEY=
HARNESS_TOOL_WEB_SEARCH_SERPAPI_API_KEY=
HARNESS_TOOL_WEB_SEARCH_API_KEY=
HARNESS_TOOL_WEB_SEARCH_ENGINE=duckduckgo
HARNESS_TOOL_FFMPEG_ENABLED=false
HARNESS_TOOL_FFMPEG_PATH=ffmpeg
HARNESS_TOOL_CODE_EXEC_ENABLED=false
HARNESS_TOOL_CODE_EXEC_SANDBOX=docker

# --- MCP Remote Tools / MCP 远程工具 ---
# Option 1 (recommended): JSON config file — each server can have independent timeouts
# 推荐：JSON 配置文件，每个服务器可独立设置超时
# HARNESS_MCP_CONFIG_FILE=mcp-servers.json

# Option 2: Comma-separated env var (fallback when config file is not set)
# 备选：逗号分隔环境变量（未配置 JSON 文件时使用）
HARNESS_MCP_SERVERS=filesystem=http://localhost:3001,search=http://localhost:3002
HARNESS_MCP_CONNECT_TIMEOUT_MS=5000
HARNESS_MCP_CALL_TIMEOUT_MS=30000

# --- ReAct Loop / ReAct 循环 ---
HARNESS_REACT_MAX_ITERATIONS=10
HARNESS_REACT_STRATEGY=react
HARNESS_REACT_STOP_ON_TOOL_ERROR=false
HARNESS_REACT_ENABLE_REFLECTION=true

# --- Sub-Agent / 子代理 ---
# Max concurrent sub-agent tasks per orchestrator
# 每个编排器最大并发子代理任务数
HARNESS_AGENT_MAX_SUBAGENTS=5

# --- Multimodal Input / 多模态输入 ---
HARNESS_MULTIMODAL_IMAGE_ENABLED=true
HARNESS_MULTIMODAL_VIDEO_ENABLED=false
HARNESS_MULTIMODAL_FILE_MAX_SIZE_MB=50
# Block URL attachments pointing to private/internal IPs (SSRF protection)
# 阻止 URL 附件指向私有/内网 IP（SSRF 防护）
HARNESS_MULTIMODAL_URL_BLOCK_PRIVATE_IPS=true

# --- Risk Control / 风控 ---
HARNESS_RISK_AUTO_CONFIRM=true
HARNESS_RISK_CONFIRM_TOOLS=file_delete,db_execute,send_email
HARNESS_RISK_MAX_FILE_SIZE_MB=100
HARNESS_RISK_BLOCKED_DOMAINS=


# ============================================================
# 6. Input Processing / 输入处理 (大文件解析)
# ============================================================

# File size threshold (KB) above which merge-then-summarize parsing is triggered
# 文件大小阈值 (KB)，超过此值触发合并摘要式分块解析
HARNESS_INPUT_FILE_SIZE_THRESHOLD_KB=100
# Target token count per chunk when splitting large files
# 分块目标 token 数
HARNESS_INPUT_CHUNK_TOKEN_SIZE=1024
# Model context window size in tokens (auto-detected from model name; set only to override)
# 模型上下文窗口大小 (token)，根据模型名称自动检测，仅在需要覆盖时设置
#HARNESS_MODEL_CHAT_CONTEXT_WINDOW=128000
# Fraction of context window used per summarization block (0.0-1.0)
# 每个摘要块使用的上下文窗口比例
HARNESS_LARGE_FILE_CONTEXT_RATIO=0.4
# Max parallel summarization threads for large file parsing
# 大文件解析的最大并行摘要线程数
HARNESS_LARGE_FILE_SUMMARY_CONCURRENCY=3


# ============================================================
# 7. Knowledge Base / 知识库
# ============================================================

# Upload directory for knowledge base files
# 知识库文件上传目录
HARNESS_KNOWLEDGE_UPLOAD_DIR=./knowledge-uploads
# Default collection name
# 默认知识库集合名称
HARNESS_KNOWLEDGE_DEFAULT_COLLECTION=default
# Max file size for upload (MB)
# 上传文件最大大小（MB）
HARNESS_KNOWLEDGE_MAX_FILE_SIZE_MB=50
# Chunk size for text splitting
# 文本分块大小
HARNESS_KNOWLEDGE_CHUNK_SIZE=1000
# Format support toggles
HARNESS_KNOWLEDGE_PDF_ENABLED=true
HARNESS_KNOWLEDGE_DOCX_ENABLED=true
HARNESS_KNOWLEDGE_XLSX_ENABLED=true
