<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender with color-coded output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{20}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Buffer WARN/ERROR events for periodic flush to file -->
    <appender name="LOG_BUFFER" class="com.harness.server.log.LogBufferAppender"/>

    <!-- ==================== Root ==================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOG_BUFFER"/>
    </root>

    <!-- ==================== Cyrene Agent ==================== -->
    <logger name="com.harness.agent" level="DEBUG"/>
    <logger name="com.harness.server" level="INFO"/>
    <logger name="com.harness.ai" level="DEBUG"/>
    <logger name="com.harness.preprocess" level="DEBUG"/>
    <logger name="com.harness.input" level="DEBUG"/>
    <logger name="com.harness.tool" level="DEBUG"/>
    <logger name="com.harness.audit" level="INFO"/>
    <logger name="com.harness.env" level="INFO"/>

    <!-- ==================== Third-party ==================== -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="io.javalin" level="INFO"/>
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="okhttp3" level="WARN"/>
    <logger name="dev.langchain4j" level="INFO"/>
    <logger name="io.milvus" level="WARN"/>
    <logger name="com.fasterxml.jackson" level="WARN"/>

</configuration>
